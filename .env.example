# Shared server config
PORT=8787
API_PUBLIC_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173\nWEB_PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/discord_manager

# Discord Developer Portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=

# Any unique random string of at least 32 characters. Keep it secret and never change it after encrypted data exists.
SESSION_ENCRYPTION_KEY=

# Optional: PayPay Open Payment API
PAYPAY_ENV=sandbox
PAYPAY_API_KEY=
PAYPAY_API_SECRET=
PAYPAY_MERCHANT_ID=

# Independent Discord-Security bridge (Main dashboard remains the only dashboard)
# Security Worker public origin, e.g. https://discord-security.<account>.workers.dev
SECURITY_API_BASE_URL=
# Same random 32+ character secret configured on Discord-Security Worker.
SECURITY_BRIDGE_SECRET=
